# 서버 ROS 2 Domain과 관제 WebSocket/명령 API 설정이다.
SERVER_ROS_DOMAIN_ID=225

# 실제 차량 LAN 주소로 변경한다. Foxglove는 telemetry 수집에만 사용한다.
ROBOT_1_FOXGLOVE_URI=ws://192.168.100.38:8765
ROBOT_2_FOXGLOVE_URI=ws://192.168.100.35:8765

# Fleet Manager 명령은 각 차량의 vehicle_command_api HTTP endpoint로만 전달한다.
ROBOT_1_COMMAND_API_URL=http://192.168.100.38:8082
ROBOT_2_COMMAND_API_URL=http://192.168.100.35:8082

# 서버 테스트 명령 API. 기본값은 서버 localhost만 수신한다.
# 외부 Fleet Manager에서 시험해야 할 때만 0.0.0.0으로 변경하고 방화벽을 적용한다.
COMMAND_API_HOST=0.0.0.0
COMMAND_API_PORT=8080

SERVER_IMAGE=mentorpi-fleet-bridge-server:humble

# 중앙 서버의 rosbag2 저장 디렉터리. Compose 실행 전에 호스트에 생성한다.
ROSBAG_HOST_DIRECTORY=/srv/fleet-rosbag
# 비워두면 UTC 시각 기반 세션 이름을 사용한다. 기존 세션 이름은 덮어쓰지 않는다.
ROSBAG_SESSION_ID=

# 서버 컨테이너 내부 DDS는 Fast DDS의 기본 SHM+UDP를 사용한다.
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
FASTDDS_BUILTIN_TRANSPORTS=DEFAULT
FRESHNESS_TIMEOUT_SEC=10
LOG_LEVEL=INFO
