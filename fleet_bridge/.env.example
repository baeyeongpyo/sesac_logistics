# 차량에서 robot_2를 실행할 때는 ROBOT_ID와 ROS_DOMAIN_ID를 각각 변경한다.
ROBOT_ID=robot_1
ROS_DOMAIN_ID=215
SERVER_ROS_DOMAIN_ID=225

# 실제 차량 LAN 주소로 변경한다. fleet 서비스는 8766, 직접 debug는 8765이다.
ROBOT_1_FOXGLOVE_URI=ws://192.168.10.215:8766
ROBOT_2_FOXGLOVE_URI=ws://192.168.10.216:8766

VEHICLE_IMAGE=mentorpi-fleet-bridge-vehicle:humble
SERVER_IMAGE=mentorpi-fleet-bridge-server:humble

# 컨테이너 간 로컬 DDS는 Fast DDS의 기본 SHM+UDP를 사용한다.
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
FASTDDS_BUILTIN_TRANSPORTS=DEFAULT
FRESHNESS_TIMEOUT_SEC=10
LOG_LEVEL=INFO
