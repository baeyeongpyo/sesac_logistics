<sdf version="1.10" xmlns:gz="http://gazebosim.org/schema">
  <model name="hiwonder_mecanum_forklift">
    <link name="chassis">
      <pose>-0.005 0 0.075 0 0 0</pose>
      <inertial><pose>-0.035 0 0 0 0 0</pose><mass>3.5</mass><inertia><ixx>0.016</ixx><iyy>0.018</iyy><izz>0.025</izz></inertia></inertial>
      <!-- The collision envelope follows the measured 22 cm body, excluding mast and forks. -->
      <collision name="body_collision"><geometry><box><size>0.22 0.13 0.075</size></box></geometry></collision>

      <!-- Official Hiwonder MentorPi Mecanum chassis mesh; collision stays lightweight. -->
      <visual name="official_mentorpi_chassis">
        <pose>0 0 -0.014 0 0 0</pose>
        <geometry><mesh><uri>model://hiwonder_mecanum_forklift/meshes/mentorpi/base_link.STL</uri></mesh></geometry>
        <material><ambient>0.055 0.060 0.064 1</ambient><diffuse>0.075 0.080 0.085 1</diffuse><specular>0.18 0.18 0.18 1</specular></material>
      </visual>

      <!-- Flush rear receiver mates with either automatic charging bay. -->
      <visual name="charging_receiver_backing">
        <pose>-0.109 0 0.010 0 0 0</pose>
        <geometry><box><size>0.002 0.110 0.060</size></box></geometry>
        <material><ambient>0.025 0.030 0.033 1</ambient><diffuse>0.04 0.047 0.052 1</diffuse><specular>0.12 0.12 0.12 1</specular></material>
      </visual>
      <visual name="charging_receiver_left">
        <pose>-0.1097 0.031 0.010 0 0 0</pose>
        <geometry><box><size>0.001 0.027 0.038</size></box></geometry>
        <material><ambient>0.46 0.30 0.08 1</ambient><diffuse>0.68 0.46 0.14 1</diffuse><specular>0.48 0.38 0.20 1</specular></material>
      </visual>
      <visual name="charging_receiver_right">
        <pose>-0.1097 -0.031 0.010 0 0 0</pose>
        <geometry><box><size>0.001 0.027 0.038</size></box></geometry>
        <material><ambient>0.46 0.30 0.08 1</ambient><diffuse>0.68 0.46 0.14 1</diffuse><specular>0.48 0.38 0.20 1</specular></material>
      </visual>

      <visual name="raspberry_pi"><pose>-0.026 -0.006 0.018 0 0 0</pose><geometry><box><size>0.085 0.056 0.006</size></box></geometry><material><ambient>0.015 0.26 0.10 1</ambient><diffuse>0.020 0.34 0.13 1</diffuse></material></visual>
      <visual name="pi_usb_ports"><pose>-0.018 -0.039 0.019 0 0 0</pose><geometry><box><size>0.032 0.011 0.014</size></box></geometry><material><ambient>0.55 0.57 0.58 1</ambient><diffuse>0.68 0.70 0.71 1</diffuse><specular>0.35 0.35 0.35 1</specular></material></visual>
      <visual name="pi_ethernet_port"><pose>-0.052 -0.039 0.019 0 0 0</pose><geometry><box><size>0.020 0.012 0.016</size></box></geometry><material><ambient>0.50 0.52 0.54 1</ambient><diffuse>0.62 0.64 0.66 1</diffuse></material></visual>
      <visual name="pi_heatsink"><pose>-0.030 0.004 0.024 0 0 0</pose><geometry><box><size>0.036 0.032 0.010</size></box></geometry><material><ambient>0.055 0.060 0.065 1</ambient><diffuse>0.075 0.080 0.085 1</diffuse><specular>0.30 0.30 0.30 1</specular></material></visual>
      <visual name="motor_controller"><pose>0.050 0 0.017 0 0 0</pose><geometry><box><size>0.052 0.056 0.008</size></box></geometry><material><ambient>0.04 0.10 0.18 1</ambient><diffuse>0.05 0.14 0.24 1</diffuse></material></visual>
      <visual name="official_oradar_lidar">
        <pose>-0.012242 0 0.078501 0 0 0</pose>
        <geometry><mesh><uri>model://hiwonder_mecanum_forklift/meshes/mentorpi/lidar_Link.STL</uri></mesh></geometry>
        <material><ambient>0.025 0.028 0.032 1</ambient><diffuse>0.038 0.042 0.046 1</diffuse><specular>0.16 0.16 0.16 1</specular></material>
      </visual>

      <sensor name="lidar" type="gpu_lidar">
        <pose>-0.012242 0 0.080501 0 0 0</pose><topic>/forklift/scan</topic><update_rate>12</update_rate><always_on>true</always_on><visualize>true</visualize>
        <lidar><scan><horizontal><samples>360</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan><range><min>0.03</min><max>8.0</max><resolution>0.005</resolution></range><noise><type>gaussian</type><mean>0</mean><stddev>0.002</stddev></noise></lidar>
      </sensor>
      <sensor name="imu" type="imu"><topic>/forklift/imu</topic><update_rate>50</update_rate><always_on>true</always_on></sensor>
    </link>

