<?xml version="1.0"?>
<sdf version="1.8" xmlns:xacro="http://www.ros.org/wiki/xacro" xmlns:ignition="http://ignitionrobotics.org/schema">
  <xacro:arg name="robot_name" default="robot_1"/>
  <xacro:property name="robot_name" value="$(arg robot_name)"/>
  <xacro:property name="wheel_radius" value="0.032"/>
  <model name="${robot_name}" canonical_link="base_footprint">
    <link name="base_footprint">
      <inertial>
        <pose>0 0 0.105 0 0 0</pose><mass>2.2</mass>
        <inertia><ixx>0.010</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.012</iyy><iyz>0</iyz><izz>0.018</izz></inertia>
      </inertial>
      <collision name="chassis_collision"><pose>0 0 0.105 0 0 0</pose><geometry><box><size>0.212 0.171 0.147</size></box></geometry></collision>
      <visual name="chassis_visual"><pose>0 0 0.105 0 0 0</pose><geometry><box><size>0.212 0.171 0.147</size></box></geometry>
        <material><ambient>0.04 0.28 0.62 1</ambient><diffuse>0.04 0.28 0.62 1</diffuse></material></visual>
    </link>

    <xacro:macro name="wheel" params="name x y z friction_x friction_y">
      <link name="${name}_wheel">
        <pose>${x} ${y} ${z} -1.5708 0 0</pose>
        <inertial><mass>0.05</mass><inertia><ixx>0.00002</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.00002</iyy><iyz>0</iyz><izz>0.00002</izz></inertia></inertial>
        <collision name="collision"><geometry><sphere><radius>${wheel_radius}</radius></sphere></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>0.0</mu2><fdir1 ignition:expressed_in="base_footprint">${friction_x} ${friction_y} 0</fdir1></ode></friction></surface>
        </collision>
        <visual name="visual"><geometry><cylinder><radius>${wheel_radius}</radius><length>0.024</length></cylinder></geometry>
          <material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.03 0.03 0.03 1</diffuse></material></visual>
      </link>
      <joint name="${name}_wheel_joint" type="revolute">
        <parent>base_footprint</parent><child>${name}_wheel</child>
        <axis><xyz>0 0 1</xyz><limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper></limit></axis>
      </joint>
    </xacro:macro>
    <xacro:wheel name="front_left" x="0.067052" y="0.07591" z="0.051592" friction_x="1" friction_y="-1"/>
    <xacro:wheel name="front_right" x="0.067052" y="-0.07591" z="0.051592" friction_x="1" friction_y="1"/>
    <xacro:wheel name="back_left" x="-0.06764" y="0.07591" z="0.051586" friction_x="1" friction_y="1"/>
    <xacro:wheel name="back_right" x="-0.067621" y="-0.07591" z="0.051592" friction_x="1" friction_y="-1"/>

    <link name="lidar_frame"><pose>-0.012242 -0.00008533 0.162501 0 0 0</pose>
      <inertial><mass>0.05</mass><inertia><ixx>0.00001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.00001</iyy><iyz>0</iyz><izz>0.00001</izz></inertia></inertial>
      <visual name="visual"><geometry><cylinder><radius>0.032</radius><length>0.025</length></cylinder></geometry></visual>
      <sensor name="lidar" type="gpu_lidar">
        <always_on>true</always_on><update_rate>12</update_rate><visualize>false</visualize>
        <topic>/${robot_name}/scan_raw</topic><gz_frame_id>${robot_name}/lidar_frame</gz_frame_id>
        <lidar><scan><horizontal><samples>360</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan>
          <range><min>0.08</min><max>12.0</max><resolution>0.01</resolution></range></lidar>
      </sensor>
    </link>
    <joint name="lidar_Joint" type="fixed"><parent>base_footprint</parent><child>lidar_frame</child></joint>

    <link name="depth_cam"><pose>0.061376 -0.00013463 0.121154 0 0 0</pose>
      <inertial><mass>0.08</mass><inertia><ixx>0.00002</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.00002</iyy><iyz>0</iyz><izz>0.00002</izz></inertia></inertial>
      <visual name="visual"><geometry><box><size>0.045 0.055 0.025</size></box></geometry></visual>
      <sensor name="depth_camera" type="depth_camera">
        <always_on>true</always_on><update_rate>10</update_rate><visualize>false</visualize>
        <topic>/${robot_name}/depth/image_raw</topic><gz_frame_id>${robot_name}/depth_cam</gz_frame_id>
        <camera><horizontal_fov>1.047</horizontal_fov><image><width>320</width><height>240</height><format>R8G8B8</format></image>
          <camera_info_topic>/${robot_name}/depth/camera_info</camera_info_topic><clip><near>0.10</near><far>8.0</far></clip></camera>
      </sensor>
    </link>
    <joint name="cam_Joint" type="fixed"><parent>base_footprint</parent><child>depth_cam</child></joint>

    <link name="imu_link"><pose>0 0 0.07 0 0 0</pose>
      <inertial><mass>0.01</mass><inertia><ixx>0.000001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.000001</iyy><iyz>0</iyz><izz>0.000001</izz></inertia></inertial>
      <sensor name="imu" type="imu"><always_on>true</always_on><update_rate>50</update_rate>
        <topic>/${robot_name}/imu/data_raw</topic><gz_frame_id>${robot_name}/imu_link</gz_frame_id></sensor>
    </link>
    <joint name="imu_joint" type="fixed"><parent>base_footprint</parent><child>imu_link</child></joint>

    <plugin filename="ignition-gazebo-mecanum-drive-system" name="ignition::gazebo::systems::MecanumDrive">
      <front_left_joint>front_left_wheel_joint</front_left_joint><front_right_joint>front_right_wheel_joint</front_right_joint>
      <back_left_joint>back_left_wheel_joint</back_left_joint><back_right_joint>back_right_wheel_joint</back_right_joint>
      <wheelbase>0.13468</wheelbase><wheel_separation>0.15182</wheel_separation><wheel_radius>${wheel_radius}</wheel_radius>
      <odom_publish_frequency>30</odom_publish_frequency><topic>/${robot_name}/controller/cmd_vel</topic>
      <odom_topic>/${robot_name}/odom</odom_topic><tf_topic>/${robot_name}/tf</tf_topic>
      <frame_id>${robot_name}/odom</frame_id><child_frame_id>${robot_name}/base_footprint</child_frame_id>
    </plugin>
  </model>
</sdf>
