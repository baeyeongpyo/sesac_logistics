# 관제 PC의 ROS 2 Domain. fleet_bridge, map_server, warehouse_server와 같아야 합니다.
SERVER_ROS_DOMAIN_ID=225
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
FASTDDS_BUILTIN_TRANSPORTS=DEFAULT

MONITORING_FOXGLOVE_IMAGE=mentorpi-monitoring-foxglove:humble
MONITORING_ASSET_IMAGE=mentorpi-monitoring-assets:latest
ASSET_DIRECTORY=./assets
ASSET_BIND_ADDRESS=0.0.0.0
ASSET_PORT=8088
