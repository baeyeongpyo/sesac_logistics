# 시연용 LAN 관제 화면의 수신 주소와 포트입니다.
CONTROL_CENTER_HOST=0.0.0.0
CONTROL_CENTER_PORT=8084

# 이 두 디렉터리는 Control Center에서 읽기 전용으로 mount합니다.
CONTROL_CENTER_DATA_DIRECTORY=../data
CONTROL_CENTER_MAP_DIRECTORY=../map_server/maps

# 모든 차량 제어는 이 Fleet Bridge Command API로만 전달합니다.
FLEET_BRIDGE_COMMAND_URL=http://host.docker.internal:8080
CONTROL_CENTER_REQUEST_TIMEOUT_SEC=3
