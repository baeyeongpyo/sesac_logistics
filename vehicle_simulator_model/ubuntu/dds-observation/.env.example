# Foxglove Studio를 신뢰된 LAN PC에서 연결할 수 있도록 모든 인터페이스에서 수신한다.
# 방화벽에서 신뢰된 출발지에만 FOXGLOVE_PORT의 TCP 접속을 허용한다.
FOXGLOVE_BIND_ADDRESS=0.0.0.0
# Foxglove WebSocket 수신 포트. 환경에 맞게 변경할 수 있다.
FOXGLOVE_PORT=8765

# map.yaml과 map.pgm이 함께 있는 호스트 지도 디렉터리. 배포 환경에 맞게 변경한다.
MAP_DIRECTORY=/srv/mentorpi/maps/current
# 관측 서버에 /clock이 없으면 false로 둔다.
MAP_USE_SIM_TIME=false
# map-server의 colcon build/install overlay named volume 이름이다.
MAP_SERVER_OVERLAY_VOLUME=mentorpi-map-server-overlay

# 기본값으로 두면 named volume mentorpi-rosbag-data에 rosbag을 누적한다.
ROSBAG_VOLUME_NAME=mentorpi-rosbag-data
# 특정 세션명이 필요할 때만 설정한다. 빈 값이면 UTC timestamp를 사용한다.
ROSBAG_SESSION_ID=
