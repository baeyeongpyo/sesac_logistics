#!/usr/bin/env bash
set -euo pipefail

: "${VEHICLE_DOMAIN:?VEHICLE_DOMAIN is required}"
: "${CONTROL_DOMAIN:?CONTROL_DOMAIN is required}"
: "${SOURCE_NAMESPACE:?SOURCE_NAMESPACE is required}"
: "${CENTRAL_PREFIX:?CENTRAL_PREFIX is required}"

readonly config_path=/tmp/domain-bridge.yaml
python3 /opt/mentorpi-domain-bridge/render_bridge_config.py \
  --vehicle-domain "$VEHICLE_DOMAIN" \
  --control-domain "$CONTROL_DOMAIN" \
  --source-namespace "$SOURCE_NAMESPACE" \
  --central-prefix "$CENTRAL_PREFIX" \
  --output "$config_path"

ros2 run domain_bridge domain_bridge "$config_path" &
readonly bridge_pid=$!
ROS_DOMAIN_ID="$CONTROL_DOMAIN" python3 /opt/mentorpi-domain-bridge/publish_bridge_status.py \
  --bridge-pid "$bridge_pid" \
  --central-prefix "$CENTRAL_PREFIX" &
readonly status_pid=$!

cleanup() {
  kill "$bridge_pid" "$status_pid" 2>/dev/null || true
  wait "$bridge_pid" "$status_pid" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

set +e
wait "$bridge_pid"
bridge_exit_code=$?
set -e
wait "$status_pid" || true
exit "$bridge_exit_code"
