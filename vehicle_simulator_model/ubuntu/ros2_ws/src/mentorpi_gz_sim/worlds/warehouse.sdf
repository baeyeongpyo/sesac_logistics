<?xml version="1.0"?>
<sdf version="1.8">
  <world name="mentorpi_warehouse">
    <physics name="1ms" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>1.0</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <scene><ambient>0.55 0.55 0.55 1</ambient><background>0.75 0.82 0.90 1</background></scene>
    <light name="sun" type="directional"><cast_shadows>true</cast_shadows><pose>0 0 8 0 0 0</pose><diffuse>0.9 0.9 0.9 1</diffuse><direction>-0.4 0.2 -1</direction></light>
    <model name="ground"><static>true</static><link name="ground_link">
      <collision name="ground_collision"><geometry><plane><normal>0 0 1</normal><size>12 10</size></plane></geometry><surface><friction><ode><mu>50</mu></ode></friction></surface></collision>
      <visual name="ground_visual"><geometry><plane><normal>0 0 1</normal><size>12 10</size></plane></geometry><material><ambient>0.55 0.55 0.55 1</ambient><diffuse>0.65 0.65 0.65 1</diffuse></material></visual>
    </link></model>
    <model name="warehouse_walls"><static>true</static><link name="walls">
      <collision name="north"><pose>0 4 0.5 0 0 0</pose><geometry><box><size>10 0.15 1</size></box></geometry></collision><visual name="north_v"><pose>0 4 0.5 0 0 0</pose><geometry><box><size>10 0.15 1</size></box></geometry></visual>
      <collision name="south"><pose>0 -4 0.5 0 0 0</pose><geometry><box><size>10 0.15 1</size></box></geometry></collision><visual name="south_v"><pose>0 -4 0.5 0 0 0</pose><geometry><box><size>10 0.15 1</size></box></geometry></visual>
      <collision name="east"><pose>5 0 0.5 0 0 0</pose><geometry><box><size>0.15 8 1</size></box></geometry></collision><visual name="east_v"><pose>5 0 0.5 0 0 0</pose><geometry><box><size>0.15 8 1</size></box></geometry></visual>
      <collision name="west"><pose>-5 0 0.5 0 0 0</pose><geometry><box><size>0.15 8 1</size></box></geometry></collision><visual name="west_v"><pose>-5 0 0.5 0 0 0</pose><geometry><box><size>0.15 8 1</size></box></geometry></visual>
    </link></model>
    <model name="shelf_left"><static>true</static><pose>1.2 1.2 0.6 0 0 0</pose><link name="body"><collision name="c"><geometry><box><size>2.2 0.6 1.2</size></box></geometry></collision><visual name="v"><geometry><box><size>2.2 0.6 1.2</size></box></geometry><material><diffuse>0.45 0.25 0.08 1</diffuse></material></visual></link></model>
    <model name="shelf_right"><static>true</static><pose>1.2 -1.2 0.6 0 0 0</pose><link name="body"><collision name="c"><geometry><box><size>2.2 0.6 1.2</size></box></geometry></collision><visual name="v"><geometry><box><size>2.2 0.6 1.2</size></box></geometry><material><diffuse>0.45 0.25 0.08 1</diffuse></material></visual></link></model>
    <model name="corridor_a_marker"><static>true</static><pose>3.5 0 0.35 0 0 0</pose><link name="body"><collision name="c"><geometry><box><size>1.5 1.1 0.7</size></box></geometry></collision><visual name="v"><geometry><box><size>1.5 1.1 0.7</size></box></geometry><material><diffuse>0.20 0.30 0.20 1</diffuse></material></visual></link></model>
  </world>
</sdf>
