<?xml version="1.0"?>
<sdf version="1.8">
  <world name="mentorpi_warehouse">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-pose-publisher-system"
            name="gz::sim::systems::PosePublisher">
      <publish_link_pose>false</publish_link_pose>
      <publish_visual_pose>false</publish_visual_pose>
      <publish_collision_pose>false</publish_collision_pose>
      <publish_sensor_pose>false</publish_sensor_pose>
      <publish_nested_model_pose>false</publish_nested_model_pose>
      <publish_model_pose>true</publish_model_pose>
      <use_pose_vector_msg>true</use_pose_vector_msg>
      <update_frequency>10</update_frequency>
      <topic>/warehouse/entity_poses</topic>
    </plugin>

    <scene>
      <ambient>0.62 0.64 0.68 1</ambient>
      <background>0.72 0.80 0.88 1</background>
      <shadows>true</shadows>
    </scene>
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.92 0.92 0.90 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <attenuation>
        <range>30</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.35 0.25 -1</direction>
    </light>

    <model name="ground">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>12 10</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>50</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>12 10</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.48 0.50 0.52 1</ambient>
            <diffuse>0.60 0.62 0.64 1</diffuse>
            <specular>0.08 0.08 0.08 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="warehouse_walls">
      <static>true</static>
      <link name="walls">
        <collision name="north">
          <pose>0 4 0.5 0 0 0</pose>
          <geometry><box><size>10 0.15 1</size></box></geometry>
        </collision>
        <visual name="north_visual">
          <pose>0 4 0.5 0 0 0</pose>
          <geometry><box><size>10 0.15 1</size></box></geometry>
          <material><diffuse>0.84 0.86 0.88 1</diffuse></material>
        </visual>
        <collision name="south">
          <pose>0 -4 0.5 0 0 0</pose>
          <geometry><box><size>10 0.15 1</size></box></geometry>
        </collision>
        <visual name="south_visual">
          <pose>0 -4 0.5 0 0 0</pose>
          <geometry><box><size>10 0.15 1</size></box></geometry>
          <material><diffuse>0.84 0.86 0.88 1</diffuse></material>
        </visual>
        <collision name="east">
          <pose>5 0 0.5 0 0 0</pose>
          <geometry><box><size>0.15 8 1</size></box></geometry>
        </collision>
        <visual name="east_visual">
          <pose>5 0 0.5 0 0 0</pose>
          <geometry><box><size>0.15 8 1</size></box></geometry>
          <material><diffuse>0.84 0.86 0.88 1</diffuse></material>
        </visual>
        <collision name="west">
          <pose>-5 0 0.5 0 0 0</pose>
          <geometry><box><size>0.15 8 1</size></box></geometry>
        </collision>
        <visual name="west_visual">
          <pose>-5 0 0.5 0 0 0</pose>
          <geometry><box><size>0.15 8 1</size></box></geometry>
          <material><diffuse>0.84 0.86 0.88 1</diffuse></material>
        </visual>
      </link>
    </model>

    <include>
      <uri>model://warehouse_conveyor</uri>
      <name>left_conveyor</name>
      <pose>-3.45 -1.55 0 0 0 1.5708</pose>
    </include>
    <include>
      <uri>model://warehouse_conveyor</uri>
      <name>pico_conveyor</name>
      <pose>-0.20 3.64 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://warehouse_robot_arm</uri>
      <name>robot_arm_upper</name>
      <pose>-3.45 1.65 0 0 0 -1.5708</pose>
    </include>
    <include>
      <uri>model://warehouse_robot_arm</uri>
      <name>robot_arm_lower</name>
      <pose>-3.45 0.55 0 0 0 -1.5708</pose>
    </include>

    <include>
      <uri>model://warehouse_charger</uri>
      <name>charging_station</name>
      <pose>4.45 0.35 0 0 0 1.5708</pose>
    </include>

    <include>
      <uri>model://warehouse_rack</uri>
      <name>fresh_rack</name>
      <pose>-0.50 1.67 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://warehouse_rack</uri>
      <name>normal_rack</name>
      <pose>3.45 3.40 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://warehouse_markings</uri>
      <name>floor_markings</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <plugin filename="mentorpi_warehouse_pallet_manager"
            name="mentorpi_gz_sim::WarehousePalletManager">
      <command_service>/warehouse/pallet/command</command_service>
      <template_dir>pallet</template_dir>
      <spawn_bounds>-4.5 4.5 -3.5 3.5</spawn_bounds>
      <default_spawn_pose>-2.5 -2.8 0 0 0 0</default_spawn_pose>
      <linear_stop_threshold>0.02</linear_stop_threshold>
      <angular_stop_threshold>0.05</angular_stop_threshold>
      <default_pallet id="pallet_01" kind="fresh" state="loaded"
                      pose="-1.0 0.6 0 0 0 0"/>
      <default_pallet id="pallet_02" kind="fresh" state="loaded"
                      pose="-0.5 0.6 0 0 0 0"/>
      <default_pallet id="pallet_03" kind="fresh" state="loaded"
                      pose="0.0 0.6 0 0 0 0"/>
      <default_pallet id="pallet_04" kind="normal" state="loaded"
                      pose="2.9 2.4 0 0 0 0"/>
      <default_pallet id="pallet_05" kind="normal" state="loaded"
                      pose="3.4 2.4 0 0 0 0"/>
      <default_pallet id="pallet_06" kind="normal" state="loaded"
                      pose="3.9 2.4 0 0 0 0"/>
    </plugin>
  </world>
</sdf>
