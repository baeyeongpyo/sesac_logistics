<?xml version="1.0"?>
<sdf version="1.10">
  <world name="pallet_manager_test">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>

    <model name="ground">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>12 10</size>
            </plane>
          </geometry>
        </collision>
      </link>
    </model>

    <model name="robot_1">
      <static>true</static>
      <pose>1.8 -2.8 0.05 0 0 0</pose>
      <link name="base_footprint"/>
    </model>
    <model name="robot_2">
      <static>true</static>
      <pose>3.2 -2.8 0.05 0 0 0</pose>
      <link name="base_footprint"/>
    </model>

    <plugin filename="mentorpi_warehouse_pallet_manager"
            name="mentorpi_gz_sim::WarehousePalletManager">
      <command_service>/warehouse/pallet/command</command_service>
      <template_dir>pallet</template_dir>
      <spawn_bounds>-4.5 4.5 -3.5 3.5</spawn_bounds>
      <default_spawn_pose>-2.5 -2.8 0 0 0 0</default_spawn_pose>
      <linear_stop_threshold>0.02</linear_stop_threshold>
      <angular_stop_threshold>0.05</angular_stop_threshold>
      <default_pallet id="pallet_01" kind="fresh" state="loaded"
                      pose="-1.0 0.6 0 0 0 0"/>
      <default_pallet id="pallet_02" kind="fresh" state="loaded"
                      pose="-0.5 0.6 0 0 0 0"/>
      <default_pallet id="pallet_03" kind="fresh" state="loaded"
                      pose="0.0 0.6 0 0 0 0"/>
      <default_pallet id="pallet_04" kind="normal" state="loaded"
                      pose="2.9 2.4 0 0 0 0"/>
      <default_pallet id="pallet_05" kind="normal" state="loaded"
                      pose="3.4 2.4 0 0 0 0"/>
      <default_pallet id="pallet_06" kind="normal" state="loaded"
                      pose="3.9 2.4 0 0 0 0"/>
    </plugin>

    <plugin filename="mentorpi_warehouse_pallet_manager"
            name="mentorpi_gz_sim::WarehousePalletManager">
      <command_service>/warehouse/pallet/broken_command</command_service>
      <template_dir>missing-pallet-templates</template_dir>
      <spawn_bounds>-4.5 4.5 -3.5 3.5</spawn_bounds>
    </plugin>
  </world>
</sdf>
