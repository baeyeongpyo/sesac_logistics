<?xml version="1.0" ?>
<sdf version="1.10">
  <model name="@PALLET_ID@_payload" canonical_link="payload_link">
    <pose>@PAYLOAD_POSE@</pose>
    <link name="payload_link">
      <inertial>
        <mass>0.25</mass>
        <inertia>
          <ixx>0.00032552</ixx><iyy>0.00032552</iyy><izz>0.00065104</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="normal_box_front">
        <pose>0 -0.03125 0.0375 0 0 0</pose>
        <geometry><box><size>0.125 0.0625 0.075</size></box></geometry>
        <material><diffuse>0.1 0.3 0.8 1</diffuse></material>
      </visual>
      <visual name="normal_box_rear">
        <pose>0 0.03125 0.0375 0 0 0</pose>
        <geometry><box><size>0.125 0.0625 0.075</size></box></geometry>
        <material><diffuse>0.1 0.3 0.8 1</diffuse></material>
      </visual>
      <collision name="payload_collision">
        <pose>0 0 0.0375 0 0 0</pose>
        <geometry><box><size>0.125 0.125 0.075</size></box></geometry>
      </collision>
    </link>
  </model>
</sdf>
