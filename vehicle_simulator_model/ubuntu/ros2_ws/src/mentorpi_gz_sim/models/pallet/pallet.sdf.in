<?xml version="1.0" ?>
<sdf version="1.10">
  <model name="@PALLET_ID@" canonical_link="pallet_link">
    <pose>@POSE@</pose>
    <self_collide>true</self_collide>
    <link name="pallet_link">
      <inertial>
        <mass>0.12</mass>
        <inertia>
          <ixx>0.00019125</ixx><iyy>0.00019125</iyy><izz>0.00036450</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="deck">
        <pose>0 0 0.027 0 0 0</pose>
        <geometry><box><size>0.135 0.135 0.006</size></box></geometry>
        <material><diffuse>0.55 0.32 0.12 1</diffuse></material>
      </visual>
      <collision name="deck_collision">
        <pose>0 0 0.027 0 0 0</pose>
        <geometry><box><size>0.135 0.135 0.006</size></box></geometry>
        <surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface>
      </collision>
      <visual name="support_left">
        <pose>0 -0.063 0.004 0 0 0</pose>
        <geometry><box><size>0.135 0.009 0.008</size></box></geometry>
        <material><diffuse>0.45 0.25 0.08 1</diffuse></material>
      </visual>
      <collision name="support_left_collision">
        <pose>0 -0.063 0.004 0 0 0</pose>
        <geometry><box><size>0.135 0.009 0.008</size></box></geometry>
        <surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface>
      </collision>
      <visual name="support_center">
        <pose>0 0 0.004 0 0 0</pose>
        <geometry><box><size>0.135 0.009 0.008</size></box></geometry>
        <material><diffuse>0.45 0.25 0.08 1</diffuse></material>
      </visual>
      <collision name="support_center_collision">
        <pose>0 0 0.004 0 0 0</pose>
        <geometry><box><size>0.135 0.009 0.008</size></box></geometry>
        <surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface>
      </collision>
      <visual name="support_right">
        <pose>0 0.063 0.004 0 0 0</pose>
        <geometry><box><size>0.135 0.009 0.008</size></box></geometry>
        <material><diffuse>0.45 0.25 0.08 1</diffuse></material>
      </visual>
      <collision name="support_right_collision">
        <pose>0 0.063 0.004 0 0 0</pose>
        <geometry><box><size>0.135 0.009 0.008</size></box></geometry>
        <surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface>
      </collision>
    </link>
    <plugin filename="gz-sim-detachable-joint-system"
            name="gz::sim::systems::DetachableJoint">
      <parent_link>pallet_link</parent_link>
      <child_model>@PALLET_ID@_payload</child_model>
      <child_link>payload_link</child_link>
      <attach_topic>/warehouse/pallet/@PALLET_ID@/attach</attach_topic>
      <detach_topic>/warehouse/pallet/@PALLET_ID@/detach</detach_topic>
      <output_topic>/warehouse/pallet/@PALLET_ID@/attached</output_topic>
      <suppress_child_warning>true</suppress_child_warning>
    </plugin>
  </model>
</sdf>
